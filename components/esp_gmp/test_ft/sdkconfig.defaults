# Protocol golden-frame tests still pull esp_gmp -> esp_flux, which needs NimBLE headers.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=20
CONFIG_BT_NIMBLE_TRANSPORT_EVT_SIZE=255
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=50

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_GMP_MAX_PAYLOAD=4096
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_UNITY_ENABLE_64BIT=y

CONFIG_ESP_GMP_PROFILE_OS=y
CONFIG_ESP_GMP_PROFILE_FILE_TRANSFER=y
CONFIG_ESP_GMP_PROFILE_OTA=n
