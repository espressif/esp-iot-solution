# The CI ESP32-P4 DUT is rev v1.3. ESP-IDF v5.4 supports rev 1.x,
# whereas ESP-IDF v5.5 requires rev 3.x (incompatible silicon).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# Internal SRAM must be executable when loading the ELF without PSRAM.
CONFIG_ESP_SYSTEM_PMP_IDRAM_SPLIT=n
