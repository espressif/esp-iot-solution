CONFIG_ESP_PROTOCOMM_EXT_SUPPORT_SECURITY_VERSION_0=y
CONFIG_ESP_PROTOCOMM_EXT_SUPPORT_SECURITY_VERSION_1=y
CONFIG_ESP_PROTOCOMM_EXT_SUPPORT_SECURITY_VERSION_2=y

# Tests exercise BLE APIs when NimBLE is available.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# NimBLE + Sec2/SRP makes the test binary exceed the default 1MB factory partition
# (seen on esp32c6 under IDF 5.3/5.4/5.5).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
