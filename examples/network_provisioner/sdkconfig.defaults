CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_EXAMPLE_SUPPORT_SOFTAP_WIFI=y
CONFIG_EXAMPLE_PROV_NAME_PREFIX="PROV_"
CONFIG_EXAMPLE_PROV_POP="abcd1234"
CONFIG_EXAMPLE_PROV_SEC2_USERNAME="wifiprov"
CONFIG_EXAMPLE_PROV_SEC2_PASSWORD="abcd1234"

# SoftAP + BLE can coexist when NimBLE is on; trim IRAM for ESP32.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# Enable BT so BLE Wi-Fi path compiles by default where possible.
# Disable EXAMPLE_SUPPORT_BLE_* or BT in menuconfig to shrink / fit tight IRAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_EXAMPLE_SUPPORT_BLE_WIFI=y
