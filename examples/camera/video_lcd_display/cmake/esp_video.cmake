include_guard(GLOBAL)

if(CMAKE_SOURCE_DIR STREQUAL CMAKE_BINARY_DIR)
    message(FATAL_ERROR "video_lcd_display requires an out-of-source build")
endif()

set(_esp_video_version "2.5.0")
set(_esp_video_archive_path "components/espressif/esp_video/${_esp_video_version}/espressif__esp_video-v${_esp_video_version}.zip")
set(_esp_video_sha256 "2d70fe7444b6b4d15a048a56a502d3c01a8802a5d9482815e1d2b691b19d8ab9")

file(GLOB _esp_video_patches CONFIGURE_DEPENDS
     "${CMAKE_CURRENT_LIST_DIR}/../patches/esp_video/*.patch")
list(SORT _esp_video_patches)
if(NOT _esp_video_patches)
    message(FATAL_ERROR "No esp_video patches found")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_esp_video_patches})

set(_esp_video_inputs "${_esp_video_version}:${_esp_video_sha256}")
foreach(_patch IN LISTS _esp_video_patches)
    file(SHA256 "${_patch}" _patch_hash)
    get_filename_component(_patch_name "${_patch}" NAME)
    string(APPEND _esp_video_inputs ":${_patch_name}:${_patch_hash}")
endforeach()
string(SHA256 _esp_video_fingerprint "${_esp_video_inputs}")

set(_esp_video_cache "${CMAKE_BINARY_DIR}/_esp_video")
set(_esp_video_source "${_esp_video_cache}/source")
set(_esp_video_stamp "${_esp_video_source}/.patches")
set(_esp_video_prepared "")
if(EXISTS "${_esp_video_stamp}" AND EXISTS "${_esp_video_source}/esp_video/CMakeLists.txt")
    file(READ "${_esp_video_stamp}" _esp_video_prepared)
endif()

if(NOT _esp_video_prepared STREQUAL _esp_video_fingerprint)
    find_package(Git REQUIRED)
    file(MAKE_DIRECTORY "${_esp_video_cache}")
    set(_archive "${_esp_video_cache}/esp_video-${_esp_video_version}.zip")
    if(NOT EXISTS "${_archive}")
        set(_storage_urls "$ENV{IDF_COMPONENT_LOCAL_STORAGE_URL}")
        if("$ENV{IDF_COMPONENT_STORAGE_URL}" STREQUAL "")
            list(APPEND _storage_urls "https://components-file.espressif.com")
        else()
            list(APPEND _storage_urls "$ENV{IDF_COMPONENT_STORAGE_URL}")
        endif()
        list(REMOVE_DUPLICATES _storage_urls)
        message(STATUS "Downloading esp_video ${_esp_video_version}")
        set(_download_status "No usable component storage URL")
        foreach(_storage_url IN LISTS _storage_urls)
            string(STRIP "${_storage_url}" _storage_url)
            if(_storage_url STREQUAL "")
                continue()
            endif()
            string(REGEX REPLACE "/$" "" _storage_url "${_storage_url}")
            file(DOWNLOAD "${_storage_url}/${_esp_video_archive_path}" "${_archive}"
                 TLS_VERIFY ON TIMEOUT 60 STATUS _download_status)
            list(GET _download_status 0 _download_code)
            if(_download_code EQUAL 0)
                file(SHA256 "${_archive}" _archive_hash)
                if(_archive_hash STREQUAL _esp_video_sha256)
                    break()
                endif()
                set(_download_status "Archive SHA256 mismatch")
            endif()
            file(REMOVE "${_archive}")
        endforeach()
        if(NOT EXISTS "${_archive}")
            message(FATAL_ERROR "esp_video download failed: ${_download_status}")
        endif()
    endif()
    file(SHA256 "${_archive}" _archive_hash)
    if(NOT _archive_hash STREQUAL _esp_video_sha256)
        file(REMOVE "${_archive}")
        message(FATAL_ERROR "esp_video archive SHA256 mismatch; reconfigure to download it again")
    endif()

    # Prepare separately so a failed patch cannot replace the previous source.
    set(_stage "${_esp_video_cache}/stage")
    file(REMOVE_RECURSE "${_stage}")
    file(MAKE_DIRECTORY "${_stage}/esp_video")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${_archive}"
                    WORKING_DIRECTORY "${_stage}/esp_video"
                    RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result STREQUAL "0" OR NOT EXISTS "${_stage}/esp_video/CMakeLists.txt")
        message(FATAL_ERROR "Cannot extract esp_video: ${_error}")
    endif()
    foreach(_patch IN LISTS _esp_video_patches)
        execute_process(COMMAND "${GIT_EXECUTABLE}" apply --whitespace=error-all "${_patch}"
                        WORKING_DIRECTORY "${_stage}/esp_video"
                        RESULT_VARIABLE _result ERROR_VARIABLE _error)
        if(NOT _result STREQUAL "0")
            get_filename_component(_patch_name "${_patch}" NAME)
            message(FATAL_ERROR "Failed to apply ${_patch_name}: ${_error}")
        endif()
    endforeach()
    # Archive timestamps may predate objects from the previous component version.
    file(GLOB_RECURSE _source_files LIST_DIRECTORIES false "${_stage}/esp_video/*")
    file(TOUCH ${_source_files})
    file(REMOVE_RECURSE "${_esp_video_source}")
    file(RENAME "${_stage}" "${_esp_video_source}")
    file(WRITE "${_esp_video_stamp}" "${_esp_video_fingerprint}")
    message(STATUS "Prepared esp_video ${_esp_video_version} with local patches")
endif()

list(APPEND EXTRA_COMPONENT_DIRS "${_esp_video_source}/esp_video")
