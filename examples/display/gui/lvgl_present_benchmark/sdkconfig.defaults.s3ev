# ESP32-S3-LCD-EV-Board R16: GC9503 480x480, not the generic SPI or 800x480 RGB path.
CONFIG_EXAMPLE_LCD_INTERFACE_RGB=y
# CONFIG_EXAMPLE_LCD_INTERFACE_SPI_WITH_PSRAM is not set
CONFIG_EXAMPLE_LCD_S3_EV_GC9503=y
# GC9503 RGB uses a bounce buffer, and this IDF has no framebuffer-info query.
CONFIG_PV2_LEGACY_RGB_BOUNCE_CONFIRMED=y
