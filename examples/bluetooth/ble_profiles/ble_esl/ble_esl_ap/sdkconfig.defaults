CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

CONFIG_BLE_CONN_MGR_ROLE_BOTH=y
CONFIG_BLE_CONN_MGR_EXTENDED_ADV=y
CONFIG_BLE_CONN_MGR_PERIODIC_ADV=y
CONFIG_BLE_CONN_MGR_PERIODIC_SYNC_TRANSFER=y
CONFIG_BLE_CONN_MGR_PERIODIC_ADV_WITH_RESP=y
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=2

CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=12
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# LE Secure Connections + bonding (Just Works)
CONFIG_BLE_CONN_MGR_SM=y
CONFIG_BLE_CONN_MGR_SM_IO_CAP_NO_IO=y
CONFIG_BLE_CONN_MGR_SM_CAP=10
CONFIG_BLE_CONN_MGR_SM_KEY_DIST=3
CONFIG_BLE_CONN_MGR_MAX_CONNECTIONS=3

CONFIG_BLE_ESL_PROFILE_AP=y
CONFIG_BLE_OBJECT_TRANSFER_PROFILE=y
CONFIG_BLE_OTS=y

CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=1
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=30
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=512

# NUS is added from ESP_BLE_CONN_EVENT_STARTED, after conn_mgr has started
# GATT. Static ble_gatts_add_svcs() then returns BLE_HS_EBUSY.
CONFIG_BT_NIMBLE_DYNAMIC_SERVICE=y
