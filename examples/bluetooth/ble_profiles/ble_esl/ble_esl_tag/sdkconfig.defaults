CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

CONFIG_BLE_CONN_MGR_ROLE_PERIPHERAL=y
CONFIG_BLE_CONN_MGR_EXTENDED_ADV=y
CONFIG_BLE_CONN_MGR_PERIODIC_SYNC_TRANSFER=y
CONFIG_BLE_CONN_MGR_PERIODIC_ADV_WITH_RESP=y

# LE Secure Connections + bonding (Just Works).
# Bonds must survive reboot or association restore clears tag_assoc.
CONFIG_BLE_CONN_MGR_SM=y
CONFIG_BLE_CONN_MGR_SM_IO_CAP_NO_IO=y
CONFIG_BLE_CONN_MGR_SM_CAP=10
CONFIG_BLE_CONN_MGR_SM_KEY_DIST=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=2
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

CONFIG_BLE_ESL_PROFILE=y
CONFIG_BLE_ESL=y
CONFIG_BLE_DIS=y
CONFIG_BLE_ESL_OTS_SUPPORT=y
CONFIG_BLE_OBJECT_TRANSFER_PROFILE=y
CONFIG_BLE_OTS=y
CONFIG_BLE_ESL_DISPLAY_INFO=y
CONFIG_BLE_ESL_IMAGE_INFO=y
CONFIG_BLE_ESL_LED_INFO=y
CONFIG_BLE_ESL_SENSOR_INFO=y
# Two OTS slots are required by the App flow; 4 matches the images partition.
# 4736 is one SSD1680 128x296 1bpp frame. 4096 rejects that write.
CONFIG_BLE_ESL_MAX_IMAGES=4
CONFIG_BLE_ESL_MAX_IMAGE_SIZE=4736
CONFIG_ESL_TAG_ADV_NAME="ESP_ESL_TAG"
CONFIG_ESL_TAG_MAX_IMAGES=4

# images partition in partitions.csv ends at 0x220000, so flash must be >= 4MB.
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set
# CONFIG_PARTITION_TABLE_TWO_OTA is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=1
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=30
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=512
