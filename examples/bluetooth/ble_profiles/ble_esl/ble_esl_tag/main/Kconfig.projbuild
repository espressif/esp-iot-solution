menu "BLE ESL Tag Product Example"

    config ESL_TAG_ADV_NAME
        string "Tag advertisement name"
        default "ESP_ESL_TAG"
        help
            Complete Local Name used by ble_conn_mgr advertising.

    config ESL_TAG_DISPLAY_WIDTH
        int "Display width (metadata)"
        default 296

    config ESL_TAG_DISPLAY_HEIGHT
        int "Display height (metadata)"
        default 128

    config ESL_TAG_MAX_IMAGES
        int "Maximum stored image slots (Max_Image_Index + 1)"
        range 1 255
        default 4
        help
            Reported via ESL Image Information. OTS flash persistence
            covers physical slots 0..3.

    config ESL_TAG_LED_MULTI_DEMO
        bool "Enable multi-Tag LED demo local green on SYNCHRONIZED"
        depends on ESL_TAG_LED_BACKEND_WS2812 || ESL_TAG_LED_BACKEND_GPIO
        default n
        help
            Keep disabled for mode 2 so association NVS is saved and restored.

endmenu
