menu "Example Configuration"

    orsource "$IDF_PATH/examples/common_components/env_caps/$IDF_TARGET/Kconfig.env_caps"

    config I2C_MASTER_SCL
        int "SCL GPIO Num"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 4 if IDF_TARGET_ESP32
        default 5
        help
            GPIO number for the I2C master clock line.
            ESP32 defaults to GPIO4. GPIO6 is the SPI flash clock on ESP32.

    config I2C_MASTER_SDA
        int "SDA GPIO Num"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 5 if IDF_TARGET_ESP32
        default 6
        help
            GPIO number for the I2C master data line.
            ESP32 defaults to GPIO5. GPIO6 is the SPI flash clock on ESP32.

    config I2C_MASTER_FREQUENCY
        int "Master Frequency"
        default 400000
        help
            I2C speed of the master device.

endmenu
